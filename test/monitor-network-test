      | grep -vE '^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.)' \
      | sort -u || true)

    if [[ -n "$remote_ips" ]]; then
      count=$(echo "$remote_ips" | wc -l | tr -d ' ')
      info "Checking $count public IP(s)"
      echo "$remote_ips" | while read -r ip; do
        info "  public: $ip"
      done
    fi
  )

  assert_output_contains "includes 8.8.8.8" "8.8.8.8" "$output"
  assert_output_contains "includes 203.0.113.50" "203.0.113.50" "$output"
  assert_output_not_contains "excludes 10.x" "10.0.0.1" "$output"
  assert_output_not_contains "excludes 172.16.x" "172.16.5.10" "$output"
  assert_output_not_contains "excludes 192.168.x" "192.168.1.100" "$output"
  assert_output_not_contains "excludes 127.x" "127.0.0.1" "$output"
  assert_output_contains "only 2 public IPs" "Checking 2 public" "$output"
}

# ── Test 10: High-ephemeral port warning ───────────────────────────
test_high_ephemeral_port_warned() {
  printf "\n${BOLD}${CYAN}Test: High-ephemeral ports are warned about${RESET}\n"

  local ports=":50000
:50000
:50000
:443
:443"

  local output
  output=$(
    source "$TEST_TMP/harness.bash"

    echo "$ports" | sort | uniq -c | sort -rn | head -5 \
      | while read -r cnt port; do
          p=${port#:}
          if [[ "$p" -gt 49151 ]]; then
            warn "High-ephemeral port in use ($p) — $cnt connection(s)"
          fi
        done
  )

  assert_output_contains "warns about port 50000" "High-ephemeral port.*50000" "$output"
  assert_output_not_contains "does not warn about 443" "443" "$output"
}

