# ── Test 2: Baseline device detection ──────────────────────────────
test_new_device_detected() {
  printf "\n${BOLD}${CYAN}Test: New device detected vs baseline${RESET}\n"
  > "$LOG_FILE"

  # Create a baseline with two known devices
  cat > "$BASELINE_FILE" << 'EOF'
192.168.1.1 aa:bb:cc:dd:ee:01
192.168.1.100 11:22:33:44:55:66
EOF

  # Current scan returns an extra device
  local scan
  scan=$'192.168.1.1\taa:bb:cc:dd:ee:01\tRouter\n192.168.1.100\t11:22:33:44:55:66\tLaptop\n192.168.1.200\tde:ad:be:ef:00:01\tUnknown'

  local output
  output=$(
    source "$TEST_TMP/harness.bash"

    current_devices=$(echo "$scan" | awk '{print $1, $2}' | sort)
    new_devices=$(comm -23 <(echo "$current_devices") <(sort "$BASELINE_FILE"))
    if [[ -n "$new_devices" ]]; then
      alert "New/unknown devices detected since baseline:"
      echo "$new_devices" | while read -r line; do
        alert "    $line"
        log_msg "NEW DEVICE: $line"
      done
    else
      info "All devices match the known baseline."
    fi
  )

  assert_output_contains "flags new device" "New/unknown devices" "$output"
  assert_output_contains "shows rogue device IP" "192.168.1.200" "$output"
  assert_output_contains "shows rogue device MAC" "de:ad:be:ef:00:01" "$output"
  assert_file_contains "logs new device" "NEW DEVICE.*192.168.1.200" "$LOG_FILE"
}

