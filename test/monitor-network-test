#!/usr/bin/env bash
#
# monitor-network-test — unit tests for the monitor-network script
#
# Mocks all external commands (arp, lsof, nmap, dig, etc.) and validates
# that the detection logic correctly identifies threats.
#
# Usage:  ./test/monitor-network-test
#
set -euo pipefail

# ── test framework ──────────────────────────────────────────────────
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0
FAILURES=()

RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'
BOLD='\033[1m'; RESET='\033[0m'

assert_output_contains() {
  local label="$1" pattern="$2" output="$3"
  TESTS_RUN=$((TESTS_RUN + 1))
  if echo "$output" | grep -qE "$pattern"; then
    TESTS_PASSED=$((TESTS_PASSED + 1))
    printf "  ${GREEN}✓${RESET} %s\n" "$label"
  else
    TESTS_FAILED=$((TESTS_FAILED + 1))
    FAILURES+=("$label")
    printf "  ${RED}✗${RESET} %s\n" "$label"
    printf "    expected pattern: %s\n" "$pattern"
    printf "    in output:\n%s\n" "$(echo "$output" | head -20)"
  fi
}

assert_output_not_contains() {
  local label="$1" pattern="$2" output="$3"
  TESTS_RUN=$((TESTS_RUN + 1))
  if ! echo "$output" | grep -qE "$pattern"; then
    TESTS_PASSED=$((TESTS_PASSED + 1))
    printf "  ${GREEN}✓${RESET} %s\n" "$label"
  else
    TESTS_FAILED=$((TESTS_FAILED + 1))
    FAILURES+=("$label")
    printf "  ${RED}✗${RESET} %s\n" "$label"
    printf "    pattern should NOT match: %s\n" "$pattern"
  fi
}

assert_file_contains() {
  local label="$1" pattern="$2" filepath="$3"
  TESTS_RUN=$((TESTS_RUN + 1))
  if [[ -f "$filepath" ]] && grep -qE "$pattern" "$filepath"; then
    TESTS_PASSED=$((TESTS_PASSED + 1))
    printf "  ${GREEN}✓${RESET} %s\n" "$label"
  else
    TESTS_FAILED=$((TESTS_FAILED + 1))
    FAILURES+=("$label")
    printf "  ${RED}✗${RESET} %s\n" "$label"
    printf "    expected pattern in %s: %s\n" "$filepath" "$pattern"
  fi
}

# ── setup: create isolated temp environment ─────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TEST_TMP=$(mktemp -d /tmp/monitor-net-test.XXXXXX)
MOCK_BIN="$TEST_TMP/mock-bin"
mkdir -p "$MOCK_BIN" "$TEST_TMP/config"

cleanup() { rm -rf "$TEST_TMP"; }
trap cleanup EXIT

# Export vars the script expects
export HOME="$TEST_TMP"
export PATH="$MOCK_BIN:$PATH"

# Override baseline/log dirs for isolation
BASELINE_DIR="$TEST_TMP/config/monitor-network"
BASELINE_FILE="$BASELINE_DIR/known_devices.txt"
LOG_FILE="$BASELINE_DIR/monitor.log"
mkdir -p "$BASELINE_DIR"

# ── source helper functions from the script ─────────────────────────
# We extract the function definitions without running the argument parsing
# or the main execution block.

# Disable set -e for the sourced functions so tests can capture failures
create_test_harness() {
  cat > "$TEST_TMP/harness.bash" << 'HARNESS_EOF'
#!/usr/bin/env bash
# Minimal harness that defines the helpers + section functions
# without running argument parsing or main.

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

banner()  { printf "\n${BOLD}${CYAN}═══  %s  ═══${RESET}\n" "$1"; }
info()    { printf "${GREEN}[✓]${RESET} %s\n" "$1"; }
warn()    { printf "${YELLOW}[!]${RESET} %s\n" "$1"; }
alert()   { printf "${RED}[✘]${RESET} %s\n" "$1"; }
log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S')  $1" >> "$LOG_FILE"; }

need() {
  if ! command -v "$1" &>/dev/null; then
    alert "$1 is not installed. Install with:  brew install $1"
    return 1
  fi
}
HARNESS_EOF
}

create_test_harness

# ══════════════════════════════════════════════════════════════════════
#  TEST SUITE
# ══════════════════════════════════════════════════════════════════════

# ── Test 1: ARP spoofing detection ──────────────────────────────────
test_arp_spoof_detected() {
  printf "\n${BOLD}${CYAN}Test: ARP spoofing — duplicate MACs are flagged${RESET}\n"

  # Mock arp to return duplicate MAC for different IPs
  cat > "$MOCK_BIN/arp" << 'EOF'
#!/usr/bin/env bash
cat << 'ARP'
? (192.168.1.1) at aa:bb:cc:dd:ee:01 on en0 ifscope [ethernet]
? (192.168.1.50) at aa:bb:cc:dd:ee:01 on en0 ifscope [ethernet]
? (192.168.1.100) at 11:22:33:44:55:66 on en0 ifscope [ethernet]
ARP
EOF
  chmod +x "$MOCK_BIN/arp"

  local output
  output=$(
    source "$TEST_TMP/harness.bash"
    GATEWAY="192.168.1.1"

    section_arp() {
      local arp_table
      arp_table=$(arp -a 2>/dev/null || true)
      local dupes
      dupes=$(echo "$arp_table" \
              | awk '{print $4}' \
              | grep -v incomplete \
              | sort | uniq -d || true)
      if [[ -n "$dupes" ]]; then
        alert "Duplicate MAC address(es) found — possible ARP spoofing!"
        for mac in $dupes; do
          echo "$arp_table" | grep "$mac"
          log_msg "ARP SPOOF SUSPECT: MAC $mac maps to multiple IPs"
        done
      else
        info "No duplicate MAC addresses detected in ARP table."
      fi
    }
    section_arp
  )

  assert_output_contains "detects duplicate MAC" "Duplicate MAC address" "$output"
  assert_output_contains "shows the spoofed MAC" "aa:bb:cc:dd:ee:01" "$output"
  assert_file_contains "logs ARP spoof" "ARP SPOOF SUSPECT" "$LOG_FILE"
}

