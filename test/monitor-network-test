# ── Test 8: Port scan detection (SYN flood) ────────────────────────
test_syn_flood_detected() {
  printf "\n${BOLD}${CYAN}Test: High SYN count triggers port scan alert${RESET}\n"
  > "$LOG_FILE"

  # Create a fake pcap-like file with 60 SYN packets
  local tmpfile="$TEST_TMP/syn_capture.txt"
  for i in $(seq 1 60); do
    echo "12:00:00.000000 IP 192.168.1.50.12345 > 10.0.0.1.$((i + 1000)): Flags [S], seq 0" >> "$tmpfile"
  done
  # Add some non-SYN lines
  for i in $(seq 1 10); do
    echo "12:00:00.000000 IP 10.0.0.1.80 > 192.168.1.50.54321: Flags [A], ack 1" >> "$tmpfile"
  done

  local output
  output=$(
    source "$TEST_TMP/harness.bash"

    syn_count=$(grep -c '\[S\]' "$tmpfile" 2>/dev/null || echo 0)

    if [[ "$syn_count" -gt 50 ]]; then
      alert "High SYN count ($syn_count) — possible port scan in progress!"
      log_msg "PORT SCAN: $syn_count SYN packets in 10s"
    else
      info "SYN count normal ($syn_count)."
    fi
  )

  assert_output_contains "flags port scan" "possible port scan" "$output"
  assert_file_contains "logs port scan" "PORT SCAN" "$LOG_FILE"
}

