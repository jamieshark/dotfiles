  assert_output_contains "flags telnet port 23" "Suspicious port open: 23" "$output"
  assert_output_contains "flags RDP port 3389" "Suspicious port open: 3389" "$output"
  assert_output_not_contains "does not flag port 80" "Suspicious port open: 80" "$output"
  assert_output_not_contains "does not flag port 443" "Suspicious port open: 443" "$output"
  assert_file_contains "logs suspicious ports" "SUSPICIOUS PORT" "$LOG_FILE"
}

