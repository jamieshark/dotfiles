# ── Test 3: Suspicious port detection ──────────────────────────────
test_suspicious_ports_flagged() {
  printf "\n${BOLD}${CYAN}Test: Suspicious ports are flagged${RESET}\n"
  > "$LOG_FILE"

  # Simulated nmap output with a telnet port (23) and RDP port (3389)
  local nmap_output
  nmap_output="23/tcp   open  telnet
80/tcp   open  http
443/tcp  open  https
3389/tcp open  ms-wrd-rdp"

  local output
  output=$(
    source "$TEST_TMP/harness.bash"
    GATEWAY="192.168.1.1"

    echo "$nmap_output" | while read -r line; do
      port=$(echo "$line" | awk '{print $1}')
      state=$(echo "$line" | awk '{print $2}')
      service=$(echo "$line" | awk '{print $3}')
      if echo "$port" | grep -qE '^(23|445|3389|5900|8080|8443)'; then
        alert "Suspicious port open: $port ($service) [$state]"
        log_msg "SUSPICIOUS PORT on $GATEWAY: $port $service"
