# set time zone
export TZ=America/Chicago

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
export DOTFILES="${${(%):-%x}:A:h:h}"
export DOTFILES_ROOT="$DOTFILES"

# Enable Powerlevel10k instant prompt close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load PATH configuration first.
source "$DOTFILES/system/_path.zsh"

# Load: aliases
source "$DOTFILES/zsh/aliases"

# Load: env
source "$DOTFILES/zsh/env"

# Load: plugins
source "$DOTFILES/zsh/plugins"

POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
ZSH_THEME="powerlevel10k/powerlevel10k"

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
elif [[ -n "$VERBOSE" ]]; then
  echo "oh-my-zsh not installed; run $DOTFILES/script/bootstrap"
fi

[[ ! -f "$DOTFILES/zsh/.p10k.zsh" ]] || source "$DOTFILES/zsh/.p10k.zsh"

# Load topical configuration, excluding files with explicit ordering.
config_files=("$DOTFILES"/**/*.zsh(N))
for file in "${config_files[@]}"; do
  [[ "$file" == */_path.zsh || "$file" == */completion.zsh ]] && continue
  source "$file"
done

# node
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  load_nvm() {
    unfunction nvm node npm npx
    source "$NVM_DIR/nvm.sh"
    "$@"
  }

  nvm() { load_nvm nvm "$@"; }
  node() { load_nvm node "$@"; }
  npm() { load_nvm npm "$@"; }
  npx() { load_nvm npx "$@"; }
fi
